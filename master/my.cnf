[mysqld]
server-id               = 1

# Replication
log-bin                 = mysql-bin
binlog_format           = ROW
gtid_mode               = ON
enforce_gtid_consistency = ON
log_slave_updates       = ON
relay_log_recovery      = ON

# InnoDB settings (optimized for 4GB RAM)
innodb_flush_log_at_trx_commit = 1   # full ACID, data aman saat crash
sync_binlog             = 1          # sinkron binlog ke disk setiap commit
innodb_file_per_table   = 1          # table terpisah -> manajemen lebih mudah
innodb_buffer_pool_size = 4G       # ~65% dari total RAM (4GB)
innodb_flush_method     = O_DIRECT   # kurangi double buffering

# Optional tuning
innodb_log_file_size    = 512M       # ukuran redo log (besar = performa INSERT/UPDATE lebih baik)
innodb_log_buffer_size  = 64M        # buffer log, cocok utk transaksi banyak
max_connections         = 100        # sesuaikan dengan kebutuhan
