[mysqld]
server-id               = 3
relay-log               = relay-bin
log-bin                 = mysql-bin
read_only               = ON
binlog_format           = ROW
gtid_mode               = ON
enforce_gtid_consistency = ON
log_slave_updates       = ON
relay_log_recovery      = ON

# InnoDB settings (optimized for 10GB RAM - mostly read workload)
innodb_flush_log_at_trx_commit = 1    # konsistensi tetap terjaga
sync_binlog             = 1           # aman untuk crash recovery
innodb_file_per_table   = 1
innodb_buffer_pool_size = 10G          # ~70% dari total RAM (10GB)
innodb_flush_method     = O_DIRECT

# Optional tuning
innodb_log_file_size    = 1G          # redo log lebih besar → efisien utk query besar
innodb_log_buffer_size  = 128M        # buffer log lebih besar
max_connections         = 300         # slave biasanya jadi target query banyak
